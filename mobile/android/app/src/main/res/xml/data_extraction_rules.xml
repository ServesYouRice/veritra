<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 (API 31) and later. allowBackup="false" stops cloud backup
     there, but not device-to-device transfer, so every domain of app data
     is excluded from both. The encrypted local database cannot be opened
     without its Android Keystore-bound key, which never leaves the device;
     this keeps even the unreadable copy at home. Used for API 31+;
     backup_rules.xml covers older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
