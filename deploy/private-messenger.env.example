# Install as /etc/private-messenger/private-messenger.env with mode 0600.
# Keep secrets out of this file where you can: pass them as systemd
# credentials and point the matching *_FILE variable at them (see
# private-messenger.service). If you do put the one-time setup token here,
# generate it out of band, then remove the entire line and restart Veritra
# after setup succeeds:
#   messenger-server generate-setup-token
# PRIVATE_MESSENGER_SETUP_TOKEN=

PRIVATE_MESSENGER_LOG_LEVEL=info
PRIVATE_MESSENGER_LOG_FORMAT=json
