# Install as /etc/private-messenger/private-messenger.env with mode 0600.
# Generate this value out of band before first-owner setup, then remove the
# entire line and restart Veritra after setup succeeds:
#   messenger-server generate-setup-token
# PRIVATE_MESSENGER_SETUP_TOKEN=

PRIVATE_MESSENGER_LOG_LEVEL=info
PRIVATE_MESSENGER_LOG_FORMAT=json

# Secrets (PRIVATE_MESSENGER_SETUP_TOKEN, *_VAPID_PRIVATE_KEY,
# *_FCM_PRIVATE_KEY, *_APNS_PRIVATE_KEY, *_TURN_SHARED_SECRET) may instead be
# read from a file named by the same variable with a _FILE suffix, e.g. a
# systemd credential: see LoadCredential= in private-messenger.service.
# Set either the value or the _FILE variable, never both.
