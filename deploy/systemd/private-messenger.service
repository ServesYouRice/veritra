[Unit]
Description=Veritra server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=private-messenger
Group=private-messenger
Environment=PRIVATE_MESSENGER_ADDR=127.0.0.1:8080
Environment=PRIVATE_MESSENGER_DATA_DIR=%S/private-messenger
Environment=PRIVATE_MESSENGER_ENV=production
EnvironmentFile=/etc/private-messenger/private-messenger.env
# Secrets are best passed as systemd credentials: root-owned files that only
# this service can read, never in the environment file. Before first-owner
# setup, write a token from `messenger-server generate-setup-token` to
# /etc/private-messenger/setup-token (mode 0600), uncomment these two lines,
# and remove them again after setup. The same pattern works for
# VAPID_PRIVATE_KEY, FCM_PRIVATE_KEY, APNS_PRIVATE_KEY and TURN_SHARED_SECRET.
#LoadCredential=setup-token:/etc/private-messenger/setup-token
#Environment=PRIVATE_MESSENGER_SETUP_TOKEN_FILE=%d/setup-token
StateDirectory=private-messenger
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/local/bin/messenger-server serve
Restart=on-failure
RestartSec=5
# Longer than the server's shutdown budget
# (PRIVATE_MESSENGER_SHUTDOWN_TIMEOUT, 25s by default) plus closing storage.
TimeoutStopSec=40

# Sandbox. The server writes only to its state directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=%S/private-messenger
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
