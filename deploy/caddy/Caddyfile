{
	# REPLACE: ACME contact email used for Let's Encrypt certificate notices.
	email admin@example.com

	# Caddy's error log records the failed request, URL and headers included,
	# for example when the app is restarting. Filter it like the access log.
	# Authorization is already redacted by Caddy.
	log default {
		format filter {
			request>uri delete
			request>headers>X-Recovery-Token delete
			request>headers>X-Veritra-Setup-Token delete
			request>headers>X-Veritra-Claim-Token delete
		}
	}
}

# REPLACE messenger.example.com with your real domain. Caddy provisions and
# renews the TLS certificate automatically and terminates TLS here, so HSTS is
# set at this edge — the app only emits HSTS when it terminates TLS itself,
# which it does not when running behind this proxy.
messenger.example.com {
	# Keep request URLs and credential headers (recovery capability, setup
	# token, device-link claim token) out of the proxy access log. The
	# application logs matched route patterns, and recovery credentials are
	# accepted only in a header on a fixed route.
	log {
		format filter {
			request>uri delete
			request>headers>X-Recovery-Token delete
			request>headers>X-Veritra-Setup-Token delete
			request>headers>X-Veritra-Claim-Token delete
		}
	}
	reverse_proxy messenger:8080 {
		# Overwrite client-supplied forwarding headers. The application trusts
		# only this proxy network and walks the resulting chain right-to-left.
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
	header {
		# Applied after the server's own headers, so each is sent once.
		defer
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
	}
}
