# Veritra server configuration
PRIVATE_MESSENGER_ADDR=:8080
PRIVATE_MESSENGER_DATA_DIR=./data
PRIVATE_MESSENGER_DB_PATH=./data/private-messenger.db
PRIVATE_MESSENGER_STORAGE_PATH=./data/blobs
PRIVATE_MESSENGER_INSTANCE_NAME=Veritra
PRIVATE_MESSENGER_ENV=development
PRIVATE_MESSENGER_LOG_LEVEL=info
# Use json for production log aggregation.
PRIVATE_MESSENGER_LOG_FORMAT=text
# Durable sync log retention; stale clients receive an explicit resync signal.
PRIVATE_MESSENGER_SYNC_EVENT_RETENTION_DAYS=30
# Generate a high-entropy value before remote first-owner setup; remove it afterward.
# Generate with: messenger-server generate-setup-token
PRIVATE_MESSENGER_SETUP_TOKEN=
# New password hashes are Argon2id. This is only the cost of the timing-equalising
# bcrypt comparison while legacy bcrypt hashes remain (10-15); match your old cost.
PRIVATE_MESSENGER_BCRYPT_COST=10
# Session lifetimes in days (1-365): idle since last use, and absolute since the
# last password and device-secret check. Idle must not exceed absolute.
PRIVATE_MESSENGER_SESSION_IDLE_DAYS=14
PRIVATE_MESSENGER_SESSION_ABSOLUTE_DAYS=30
# The one permanent public origin clients use, e.g. https://chat.example.com
# (lower-case host, no path, no default port). Account recovery (password plus
# recovery key) checks proofs against it and stays off (503) while it is unset.
# PRIVATE_MESSENGER_PUBLIC_ORIGIN=
# Recovery waits this many days while a device was active in the window (1-90).
# PRIVATE_MESSENGER_RECOVERY_ACTIVE_WINDOW_DAYS=7
# PRIVATE_MESSENGER_RECOVERY_WAIT_DAYS=7
# Passkey sign-in (off by default; see docs/operations.md). Needs an https public
# origin with a DNS host name that has a dot and no port. Registering a passkey
# ties users to that host name, and on Android and Apple it tells Google or
# Apple the host name.
# PRIVATE_MESSENGER_PASSKEYS=off
# Comma list of package:SHA256-fingerprint (as keytool prints it) of the Android apps.
# PRIVATE_MESSENGER_PASSKEY_ANDROID_APPS=
# Comma list of TEAMID.bundle.id of the Apple apps built for this host name.
# PRIVATE_MESSENGER_PASSKEY_APPLE_APP_IDS=
PRIVATE_MESSENGER_ENABLE_METRICS=0
# Per-conversation sync routes (C1). On by default; 0 or false turns them off.
# PRIVATE_MESSENGER_SCOPED_SYNC=1
# Shared-group layout for new communities (C0). On by default; 0 or false
# turns it off (new communities then show placeholder names only).
# PRIVATE_MESSENGER_COMMUNITY_LAYOUT=1
# Sealed sender (L2-3, D122). Off by default; see docs/operations.md.
# PRIVATE_MESSENGER_SEALED_SENDER=1
# PRIVATE_MESSENGER_SEALED_TOKENS_PER_DAY=200
PRIVATE_MESSENGER_MANAGEMENT_ADDR=127.0.0.1:9090
# Optional encrypted Web Push. Configure all three or none.
# PRIVATE_MESSENGER_VAPID_SUBSCRIBER=mailto:security@example.com
# PRIVATE_MESSENGER_VAPID_PUBLIC_KEY=
# PRIVATE_MESSENGER_VAPID_PRIVATE_KEY=
# Optional native FCM. Configure all three or none; use an environment secret,
# never a checked-in service-account file.
# PRIVATE_MESSENGER_FCM_PROJECT_ID=
# PRIVATE_MESSENGER_FCM_CLIENT_EMAIL=
# PRIVATE_MESSENGER_FCM_PRIVATE_KEY=
# Optional native APNs token authentication. Configure all four or none.
# PRIVATE_MESSENGER_APNS_TEAM_ID=
# PRIVATE_MESSENGER_APNS_KEY_ID=
# PRIVATE_MESSENGER_APNS_BUNDLE_ID=org.veritra.privateMessenger
# PRIVATE_MESSENGER_APNS_PRIVATE_KEY=
# Calls require self-hosted TURN; comma-separate turn:/turns: endpoints.
# PRIVATE_MESSENGER_TURN_URLS=turns:turn.example.com:5349?transport=tcp
# PRIVATE_MESSENGER_TURN_SHARED_SECRET=
# Comma-separated CIDRs for trusted reverse proxies. Private ranges may be as
# broad as their block; public ranges must be IPv4 /12 or IPv6 /29 or narrower.
# The proxy must append to X-Forwarded-For (or overwrite X-Real-IP).
# Example for the bundled Docker Compose network: PRIVATE_MESSENGER_TRUSTED_PROXIES=172.28.250.0/24
PRIVATE_MESSENGER_TRUSTED_PROXIES=
